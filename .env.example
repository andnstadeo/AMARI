# Copy this to a .env file and set secure values for production
# SESSION_SECRET should be a long random value
SESSION_SECRET=your_session_secret_here
ADMIN_USERNAME=admin
# Use `npm run gen-admin-hash` to generate a bcrypt hash and paste it here
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
# Optional: `DEV_ADMIN_PASSWORD` can be used for local dev only. Leave empty for safest defaults.
# DEV_ADMIN_PASSWORD=
NODE_ENV=development
PORT=3000
